def ensure_snappymail_storage(username):
    user_storage = os.path.join(SNAPPYMAIL_STORAGE, username, ".sessions")
    try:
        os.makedirs(user_storage, exist_ok=True)
        # Apply 82:82 and 770
        subprocess.run(["chown", "-R", "82:82", os.path.join(SNAPPYMAIL_STORAGE, username)], check=False)
        subprocess.run(["chmod", "-R", "770", os.path.join(SNAPPYMAIL_STORAGE, username)], check=False)
    except Exception as e:
        print(f"[!] Warning: Unable to pre-create SnappyMail storage for {username}: {e}", file=sys.stderr)


def send_welcome_email(username, display_name, email):
    ensure_snappymail_storage(username)

    msg = MIMEMultipart("alternative")
    msg["Subject"] = f"Welcome to Rohan Homelab, {display_name or username}"
    msg["From"] = SENDER
    msg["To"] = email

    html_content = render_html(username, display_name, email)
    msg.attach(MIMEText(html_content, "html", "utf-8"))

    with smtplib.SMTP_SSL(SMTP_HOST, SMTP_PORT) as server:
        server.login(SMTP_USER, SMTP_PASS)
        server.sendmail("onboarding@rohan.run.place", [email], msg.as_string())

    save_welcomed_user(username)
    print(f"[✓] Successfully delivered welcome email to {username} ({email}) from {SENDER}")


def get_all_users():
    if not os.path.exists(LLDAP_DB):
        print(f"[!] Error: LLDAP database not found at {LLDAP_DB}", file=sys.stderr)
        return []
    try:
        conn = sqlite3.connect(LLDAP_DB)
        cursor = conn.cursor()
        cursor.execute("SELECT user_id, email, display_name FROM users")
        rows = cursor.fetchall()
        conn.close()
        return [{"user_id": r[0], "email": r[1], "display_name": r[2]} for r in rows]
    except Exception as e:
        print(f"[!] Database read error: {e}", file=sys.stderr)
        return []


def run_once():
    try:
        subprocess.run(["/usr/local/bin/homelab-sync-avatars"], check=False)
    except Exception:
        pass
    users = get_all_users()
    welcomed = get_welcomed_users()
    new_users = [u for u in users if u["user_id"] not in welcomed]

    for u in new_users:
        # Ignore system accounts if any
        if u["user_id"] in ["onboarding"]:
            save_welcomed_user(u["user_id"])
            continue
        try:
            print(f"[*] New user detected: {u['user_id']} ({u['email']}). Sending welcome email...")
            send_welcome_email(u["user_id"], u["display_name"], u["email"])
        except Exception as e:
            print(f"[!] Failed to onboard user {u['user_id']}: {e}", file=sys.stderr)


def daemon_loop():
    print("[*] Rohan Homelab Onboarding Watcher Daemon started. Monitoring for new users...")
    while True:
        try:
            run_once()
        except Exception as e:
            print(f"[!] Daemon error: {e}", file=sys.stderr)
        time.sleep(10)


if __name__ == "__main__":
    if len(sys.argv) > 1:
        arg = sys.argv[1]
        if arg == "--daemon":
            daemon_loop()
        elif arg == "--check-all":
            run_once()
        else:
            # Send to specific username
            username = arg
            users = get_all_users()
            target = next((u for u in users if u["user_id"].lower() == username.lower()), None)
            if not target:
                print(f"[!] User '{username}' not found in LLDAP database.", file=sys.stderr)
                sys.exit(1)
            send_welcome_email(target["user_id"], target["display_name"], target["email"])
    else:
        run_once()
