#!/usr/bin/env python3
"""
Rohan Homelab - Automated User Onboarding & Welcome Mailer
Monitors LLDAP for newly provisioned users, initializes mailbox storage,
and delivers a welcome email payload from onboarding@rohan.run.place.
"""

import sys
import os
import time
import json
import sqlite3
import smtplib
import subprocess
from email.mime.text import MIMEText
from email.mime.multipart import MIMEMultipart

LLDAP_DB = "/home/ubuntu/Workspace/authelia/data/lldap/users.db"
SNAPPYMAIL_STORAGE = "/home/ubuntu/Workspace/authelia/data/snappymail/_data_/_default_/storage/rohan.run.place"
STATE_DIR = "/home/ubuntu/Workspace/authelia/data/onboarding"
STATE_FILE = os.path.join(STATE_DIR, "welcomed_users.json")
SMTP_HOST = "127.0.0.1"
SMTP_PORT = 465
SMTP_USER = "admin@rohan.run.place"
SMTP_PASS = "admin12345"
SENDER = "Rohan Homelab <onboarding@rohan.run.place>"
BASE_DOMAIN = "rohan.run.place"


def get_welcomed_users():
    os.makedirs(STATE_DIR, exist_ok=True)
    if os.path.exists(STATE_FILE):
        try:
            with open(STATE_FILE, "r") as f:
                return set(json.load(f))
        except Exception:
            return set()
    return set()


def save_welcomed_user(username):
    users = get_welcomed_users()
    users.add(username)
    os.makedirs(STATE_DIR, exist_ok=True)
    with open(STATE_FILE, "w") as f:
        json.dump(sorted(list(users)), f, indent=2)


