[Unit]
Description=Rohan Homelab Automated User Onboarding & Welcome Mailer
After=docker.service
Wants=docker.service

[Service]
Type=simple
User=root
ExecStart=/usr/local/bin/homelab-onboarding-daemon --daemon
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
